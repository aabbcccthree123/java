<%@ page language="java" contentType="text/html; charset=UTF-8"%>
<%@ page import="java.util.*" %>
<!DOCTYPE html>
<html>
<head>
<title>Employee Details</title>
<style>
* {
box-sizing: border-box;
}
body {
margin: 0;
font-family: Arial, sans-serif;
background: #f4f6f9;
min-height: 100vh;
display: flex;
justify-content: center;
align-items: center;
}
.card {
width: 500px;
background: white;
padding: 35px 40px;
border-radius: 12px;
box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
}
h2 {
text-align: center;
color: #1f2937;
margin-bottom: 30px;
}
.detail {
background: #f8fafc;
padding: 13px 15px;
margin-bottom: 12px;
border-radius: 6px;
border-left: 4px solid #2563eb;
}
.detail strong {
display: inline-block;
width: 100px;
color: #374151;
}
.back-btn {
display: block;
text-align: center;
text-decoration: none;
background: #2563eb;
color: white;
padding: 12px;
border-radius: 6px;
margin-top: 25px;
font-weight: bold;
}
.back-btn:hover {
background: #1d4ed8;
}
</style>
</head>
<body>
<%
String name = request.getParameter("name");
String ageStr = request.getParameter("age");
String email = request.getParameter("email");
String gender = request.getParameter("gender");
String[] hobbies = request.getParameterValues("hobbies");
boolean isValid = true;
if (name == null || name.trim().isEmpty())
isValid = false;
if (ageStr == null || ageStr.trim().isEmpty())
isValid = false;
if (email == null || email.trim().isEmpty())
isValid = false;
if (gender == null)
isValid = false;
int age = 0;
try {
age = Integer.parseInt(ageStr);
if (age < 18 || age > 60)
isValid = false;
} catch (Exception e) {
isValid = false;
}
if (!isValid) {
response.sendRedirect("index.jsp?error=1");
return;
}
%>
<div class="card">
<h2>Employee Details</h2>
<div class="detail">
<strong>Name:</strong>
<%= name %>
</div>
<div class="detail">
<strong>Age:</strong>
<%= age %>
</div>
<div class="detail">
<strong>Email:</strong>
<%= email %>
</div>
<div class="detail">
<strong>Gender:</strong>
<%= gender %>
</div>
<div class="detail">
<strong>Hobbies:</strong>
<%
if (hobbies != null) {
for (String h : hobbies) {
out.print(h + " ");
}
} else {
out.print("None");
}
%>
</div>
<a href="index.jsp" class="back-btn">Back to Registration</a>
</div>
</body>
</html>
