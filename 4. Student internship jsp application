<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Student Internship Form</title>
    <style>
        body{
            font-family: Arial, sans-serif;
            background:#f2f2f2;
        }
        .container{
            width:500px;
            margin:30px auto;
            background:white;
            padding:20px;
            border-radius:10px;
            box-shadow:0px 0px 10px gray;
        }
        h2{
            text-align:center;
            color:blue;
        }
        input,select{
            width:100%;
            padding:8px;
            margin-top:5px;
            margin-bottom:10px;
        }
        .radio,.check{
            width:auto;
        }
        input[type=submit]{
            background:green;
            color:white;
            border:none;
            cursor:pointer;
        }
        input[type=submit]:hover{
            background:darkgreen;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Student Internship Submission Form</h2>
        <form action="internship_display.jsp" method="post">
            <label>Name</label>
            <input type="text" name="studentName" required>
            <label>Register Number</label>
            <input type="text" name="registerNumber" required>
            <label>Department</label>
            <select name="department">
                <option>CSE</option>
                <option>IT</option>
                <option>ECE</option>
                <option>EEE</option>
            </select>
            <label>Year</label>
            <input type="number" name="year" min="1" max="4" required>
            <label>Email</label>
            <input type="email" name="email" required>
            <label>Phone Number</label>
            <input type="tel" name="phone" pattern="[0-9]{10}" required>
            <label>Internship Company</label>
            <input type="text" name="companyName" required>
            <label>Duration (Months)</label>
            <input type="number" name="duration" min="1" max="12" required>
            <label>Internship Mode</label><br>
            <input class="radio" type="radio" name="mode" value="Online" required> Online
            <input class="radio" type="radio" name="mode" value="Offline"> Offline
            <br><br>
            <label>Stipend (₹)</label>
            <input type="number" name="stipend">
            <label>Start Date</label>
            <input type="date" name="startDate" required>
            <label>Guide Name</label>
            <input type="text" name="guideName">
            <label>Skills</label><br>
            <input class="check" type="checkbox" name="skills" value="Java"> Java
            <input class="check" type="checkbox" name="skills" value="Python"> Python
            <input class="check" type="checkbox" name="skills" value="SQL"> SQL
            <br><br>
            <input type="submit" value="Submit Internship Details">
        </form>
    </div>
</body>
</html>

